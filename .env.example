# Copia este archivo como .env y completa los valores. El .env nunca se sube a git.
# toda variable nueva se documenta aquí con un valor de ejemplo seguro.
# Para publicar una tienda con Docker, la plantilla es deploy/tienda.env.example.
# Las variables del frontend (VITE_API_URL) están en frontend/.env.example.

# ===== Django =====
# Desarrollo: DEBUG=True. Producción: omitirla o False (los ajustes de seguridad quedan activos por defecto).
DEBUG=True
# Obligatoria con DEBUG=False (no puede empezar con "django-insecure"). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Cambiarla cierra todas las sesiones y JWT vigentes.
SECRET_KEY=
# Cifra las credenciales de los medios de pago que el admin carga desde el panel.
# Obligatoria con DEBUG=False; en desarrollo, si falta, se usa la SECRET_KEY. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la cambias, hay que volver a cargar las credenciales de los medios de pago desde el panel.
CLAVE_CIFRADO_CREDENCIALES=
# Dominios que atiende el backend, separados por coma. Con DEBUG=True, por defecto: localhost,127.0.0.1
ALLOWED_HOSTS=
# Orígenes del frontend que pueden llamar a la API. Con DEBUG=True, por defecto: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
# Orígenes HTTPS de confianza para formularios con CSRF (ej. https://api.mitienda.cl), separados por coma
CSRF_TRUSTED_ORIGINS=
# URL pública del frontend: Webpay vuelve al backend y este redirige aquí (pago exitoso, cancelado, rechazado).
# También la usan los enlaces de los correos: seguimiento del pedido, reseñas y nueva contraseña
FRONTEND_URL=http://localhost:5173
# Exige que Términos y Condiciones y Política de Privacidad estén publicadas para poder comprar.
# Por defecto: activo con DEBUG=False (producción) y apagado con DEBUG=True (desarrollo).
# EXIGIR_PAGINAS_LEGALES=True

# ===== Inicio de sesión con Google (RN-04) =====
# ID de cliente OAuth de tipo "Aplicación web" (Google Cloud Console > Google Auth Platform > Clientes).
# Es público: termina en .apps.googleusercontent.com. El secreto del cliente NO se usa: no lo pongas aquí.
# En "Orígenes de JavaScript autorizados" va la URL del frontend (en desarrollo: http://localhost:5173).
# Vacío = la tienda no ofrece iniciar sesión con Google (el botón no aparece).
GOOGLE_CLIENT_ID=

# ===== Correos al comprador (RF-04.2) =====
# Orden de prioridad: RESEND_API_KEY (Resend) > EMAIL_HOST (SMTP) > nada (se imprimen en la consola del runserver).
#
# Resend (para la tienda del cliente, con su dominio propio): envía por API HTTPS, así que funciona aunque el
# proveedor del servidor bloquee el SMTP. API key en resend.com > API Keys. El remitente (DEFAULT_FROM_EMAIL) debe
# usar un dominio verificado en Resend; con onboarding@resend.dev solo entrega a la dirección de la cuenta de
# Resend. Déjala vacía para usar Gmail.
RESEND_API_KEY=
#
# SMTP (mientras no haya dominio: Gmail en desarrollo y en las demos): activa la verificación en 2 pasos de
# tu cuenta y crea una "contraseña de aplicación" (myaccount.google.com/apppasswords); va en
# EMAIL_HOST_PASSWORD, nunca tu contraseña normal. Gmail permite ~500 correos al día: sirve para probar, no
# para una tienda en producción.
EMAIL_HOST=
# EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente que ve el comprador, ej.: Mi Tienda <ventas@mitienda.cl>. Con Resend, de un dominio verificado;
# con Gmail, la misma cuenta.
DEFAULT_FROM_EMAIL=
# Segundos máximos de espera al servidor de correo (por defecto 10)
# EMAIL_TIMEOUT=10

# ===== HTTPS =====
# Con DEBUG=False están activos por defecto; con DEBUG=True, apagados. Descomenta solo para cambiarlos.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# Segundos que el navegador recuerda "solo HTTPS" (HSTS). Por defecto 3600; subir a 31536000 solo después de
# verificar que el HTTPS funciona, porque el navegador lo recuerda aunque luego se desactive.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Confía en el encabezado X-Forwarded-Proto del proxy del hosting, que es quien termina el HTTPS.
# Sin esto, SECURE_SSL_REDIRECT redirige en bucle. Desactivar solo si Django recibe HTTPS directamente.
# CONFIAR_PROXY_HTTPS=True

# ===== PostgreSQL (valores de docker-compose.yml, solo desarrollo) =====
POSTGRES_DB=ecommercedb
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== MongoDB (valores de docker-compose.yml, solo desarrollo) =====
MONGO_URI=mongodb://root:rootpassword@localhost:27017/ecommerce_mongo_db?authSource=admin
# Opcional: servidor donde los tests del catálogo crean bases temporales (por defecto, MONGO_URI)
# MONGO_TEST_URI=mongodb://root:rootpassword@localhost:27017/?authSource=admin

# ===== Imágenes subidas: catálogo, identidad de la tienda y blog (ver docs/IMAGENES_CATALOGO.md) =====
# Por defecto: <carpeta del proyecto>/media y /media/
# MEDIA_ROOT=
# MEDIA_URL=/media/
# Archivos que solo ve el admin (fotos de las cotizaciones): fuera de MEDIA_ROOT y sin publicar.
# Por defecto: <carpeta del proyecto>/privado
# ARCHIVOS_PRIVADOS_ROOT=
# CATALOGO_IMAGEN_MAX_BYTES=5242880
# CATALOGO_IMAGEN_MAX_ARCHIVOS=10
# CATALOGO_IMAGEN_MAX_GALERIA=20
# CATALOGO_IMAGEN_MAX_PIXELES=20000000

# ===== Servidor =====
# Carpeta donde `python manage.py collectstatic` junta los estilos del admin de Django; whitenoise los sirve.
# Por defecto: <carpeta del proyecto>/staticfiles
# STATIC_ROOT=
# Nivel de los registros en la consola: DEBUG, INFO (por defecto), WARNING o ERROR
# LOG_LEVEL=INFO

# ===== Proveedores de logística y pago =====
# No van en el .env: el admin los configura desde el panel, con las credenciales cifradas.
#
# Chilexpress: Configuración > Envíos por courier. Las antiguas CHILEXPRESS_API_KEY_* solo se leen una vez,
# al migrar (0022), para conservar las llaves que había; después se pueden borrar del .env.
#
# Transbank, Mercado Pago y transferencia se configuran desde el panel del admin (Configuración > Medios de pago),
# con las credenciales cifradas. Las antiguas TRANSBANK_ENVIRONMENT y TRANSBANK_WEBPAY_* solo se leen una vez,
# al migrar (0017), para conservar la configuración que había; después se pueden borrar del .env.
